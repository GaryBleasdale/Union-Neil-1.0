---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  bodyStyle?: string;
  analytics?: boolean;
}

const { title, description, canonical, bodyClass, bodyStyle, analytics = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/img/union_neil_favicon.png" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class={bodyClass} style={bodyStyle}>
    <slot />
    {
      /* Clarity must load after the stylesheet: it reads layout as soon as it
         runs, and doing that before the CSS arrives makes the whole page shift
         (CLS ~0.9 on slow connections). An inline script at the end of <body>
         waits for the stylesheet in <head> before it executes. */
      analytics && (
        <script is:inline>
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "fy7s8gh2x9");
        </script>
      )
    }
    {
      /* Google tag: Google Ads (conversions for bidding) + GA4 (lead sources
         across all channels). gtag.js is ~360 KiB and ~500 ms of CPU
         on mobile, so it's only fetched on the visitor's first scroll, tap,
         click or key press. Visitors who never interact aren't recorded (on
         purpose). Calls made before it arrives (the page view, conversions
         from Contact.astro) queue in dataLayer and are sent once it loads. */
      analytics && (
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", "AW-11343656312");
          gtag("config", "G-T55SWE3RWZ");
          (function () {
            var events = ["scroll", "pointerdown", "keydown"];
            function load() {
              events.forEach(function (e) { removeEventListener(e, load); });
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=AW-11343656312";
              document.body.appendChild(s);
            }
            events.forEach(function (e) { addEventListener(e, load, { passive: true }); });
          })();
        </script>
      )
    }
  </body>
</html>
