---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import HeroCro from "../components/HeroCro.astro";
import HeroFullImage from "../components/HeroFullImage.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import VideoTestimonial from "../components/VideoTestimonial.astro";
import Reviews from "../components/Reviews.astro";
import CuidadoTotal from "../components/CuidadoTotal.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import Visit from "../components/Visit.astro";
import Footer from "../components/Footer.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import { getImage } from "astro:assets";
import { artDirectedSources } from "../lib/images";
import logo from "../assets/logo.png";
import heroMobile from "../assets/mobile_hero_placeholder-min.avif";
import heroDesktop from "../assets/hero_desktop_placeholder-min.avif";

// Which hero to show: "cro" (text and WhatsApp button first, team photo beside
// or below) or "full" (full-bleed photo with the headline over it).
const HERO = "cro" as "cro" | "full";
const Hero = HERO === "cro" ? HeroCro : HeroFullImage;

// The full-image hero's photo is preloaded on phones; same transforms as
// HeroFullImage, so these resolve to the URLs the page requests. HeroCro's
// photo is a plain <img> near the top with `priority`, so it needs no preload.
const hero = HERO === "full" ? await artDirectedSources(heroMobile, heroDesktop) : null;
const optimizedLogo = await getImage({ src: logo, format: "avif" });

// Business details for Google (address, phone, service area), shown in local results.
const businessJsonLd = {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    name: "Union Neil",
    legalName: "Union Neil Ltda.",
    description:
        "Home care e cuidados domiciliares com cuidadores de idosos gerenciados e supervisionados por enfermeiras.",
    url: "https://unionneil.com.br",
    logo: new URL(logo.src, Astro.site).href,
    telephone: "+55 15 98101-2944",
    email: "atendimento@unionneil.com.br",
    taxID: "48.768.101/0001-33",
    address: {
        "@type": "PostalAddress",
        streetAddress:
            "Av. Washington Luiz, 310, Torre White, Sala 116 - Jardim Emilia",
        addressLocality: "Sorocaba",
        addressRegion: "SP",
        postalCode: "18031-000",
        addressCountry: "BR",
    },
    areaServed: [
        "Sorocaba",
        "Votorantim",
        "Salto de Pirapora",
        "Araçoiaba da Serra",
    ].map((name) => ({
        "@type": "City",
        name,
    })),
};
---

<Layout
    title="Union Neil | Home Care e Cuidados Domiciliares em Sorocaba e Região"
    shareTitle="Union Neil | Assistência e Cuidados Domiciliares"
    description="Home Care em Sorocaba e Região. Equipes supervisionadas e gerenciadas por enfermeiras experientes. Recupere sua paz e tranquilidade."
    canonical="https://unionneil.com.br"
    bodyClass="font-lato"
    analytics
>
    <Fragment slot="head">
        {hero && (
            <link
                rel="preload"
                as="image"
                imagesrcset={hero.mobile.srcSet.attribute}
                imagesizes="100vw"
                media="(max-width:639px)"
                fetchpriority="high"
            />
        )}
        <link rel="preload" as="image" href={optimizedLogo.src} />
        <!-- The hero's text (bold headline and eyebrow, regular subline) sits
             above its photo, so if these fonts arrive after first paint the
             text reflows and pushes the photo down (CLS). Preloading them
             makes them usually ready before first paint. -->
        <link rel="preload" as="font" type="font/woff2" href="/fonts/lato-v24-latin-700.woff2" crossorigin />
        <link rel="preload" as="font" type="font/woff2" href="/fonts/lato-v24-latin-regular.woff2" crossorigin />
        <!-- The hero subline is italic. -->
        <link rel="preload" as="font" type="font/woff2" href="/fonts/lato-v24-latin-italic.woff2" crossorigin />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(businessJsonLd)}
        />
    </Fragment>

    <Nav />
    <main>
        <Hero />
        <About />
        <VideoTestimonial />
        <Services />
        <CuidadoTotal />
        <Reviews />
        <Contact />
        <Faq />
        <Visit />
    </main>
    <Footer />
    <WhatsAppWidget />
</Layout>
