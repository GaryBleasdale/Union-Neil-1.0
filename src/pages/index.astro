---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import VideoTestimonial from "../components/VideoTestimonial.astro";
import Reviews from "../components/Reviews.astro";
import CuidadoTotal from "../components/CuidadoTotal.astro";
import Contact from "../components/Contact.astro";
import Faq from "../components/Faq.astro";
import Visit from "../components/Visit.astro";
import Footer from "../components/Footer.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import { getImage } from "astro:assets";
import { artDirectedSources } from "../lib/images";
import logo from "../assets/logo.png";
import heroMobile from "../assets/mobile_hero_placeholder-min.avif";
import heroDesktop from "../assets/hero_desktop_placeholder-min.avif";

// Same transforms as <Hero> and <Nav>, so these resolve to the URLs the page requests.
const hero = await artDirectedSources(heroMobile, heroDesktop);
const optimizedLogo = await getImage({ src: logo, format: "avif" });

// Business details for Google (address, phone, service area), shown in local results.
const businessJsonLd = {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    name: "Union Neil",
    legalName: "Union Neil Ltda.",
    description:
        "Home care e cuidados domiciliares com cuidadores de idosos gestionados e supervisionados por enfermeiras.",
    url: "https://unionneil.com.br",
    logo: new URL(logo.src, Astro.site).href,
    telephone: "+55 15 98101-2944",
    email: "atendimento@unionneil.com.br",
    taxID: "48.768.101/0001-33",
    address: {
        "@type": "PostalAddress",
        streetAddress:
            "Av. Washington Luiz, 310, Torre White, Sala 116 - Jardim Emilia",
        addressLocality: "Sorocaba",
        addressRegion: "SP",
        postalCode: "18031-000",
        addressCountry: "BR",
    },
    areaServed: [
        "Sorocaba",
        "Votorantim",
        "Salto de Pirapora",
        "Araçoiaba da Serra",
    ].map((name) => ({
        "@type": "City",
        name,
    })),
};
---

<Layout
    title="Home Care em Sorocaba | Union Neil – Cuidados Domiciliares"
    shareTitle="Union Neil | Assistência e Cuidados Domiciliares"
    description="Home care e cuidadores de idosos em Sorocaba, Votorantim, Salto de Pirapora e Araçoiaba da Serra, com equipe supervisionada e gestionada por enfermeiras experientes."
    canonical="https://unionneil.com.br"
    bodyClass="font-lato"
    analytics
>
    <Fragment slot="head">
        <link
            rel="preload"
            as="image"
            imagesrcset={hero.mobile.srcSet.attribute}
            imagesizes="100vw"
            media="(max-width:639px)"
            fetchpriority="high"
        />
        <link rel="preload" as="image" href={optimizedLogo.src} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(businessJsonLd)}
        />
    </Fragment>

    <Nav />
    <main>
        <Hero />
        <About />
        <Services />
        <VideoTestimonial />
        <Reviews />
        <CuidadoTotal />
        <Contact />
        <Faq />
        <Visit />
    </main>
    <Footer />
    <WhatsAppWidget />
</Layout>
