---
// <picture> with a different source image for mobile and desktop, which
// astro:assets <Picture> can't do on its own.
import { artDirectedSources } from "../lib/images";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src"> {
    mobile: ImageMetadata;
    desktop: ImageMetadata;
    sizes: string;
    alt: string;
    /** Viewport width (px) from which the desktop image is used. */
    breakpoint?: number;
}

const { mobile, desktop, sizes, breakpoint = 640, class: className, ...imgAttrs } = Astro.props;
const sources = await artDirectedSources(mobile, desktop);
---

<picture>
    <source
        srcset={sources.mobile.srcSet.attribute}
        sizes={sizes}
        media={`(max-width:${breakpoint - 1}px)`}
        width={mobile.width}
        height={mobile.height}
    />
    <source
        srcset={sources.desktop.srcSet.attribute}
        sizes={sizes}
        media={`(min-width:${breakpoint}px)`}
        width={desktop.width}
        height={desktop.height}
    />
    <img
        src={sources.desktop.src}
        width={desktop.width}
        height={desktop.height}
        class:list={["w-full", className]}
        {...imgAttrs}
    />
</picture>
