---
// <picture> with a different source image for mobile and desktop, which
// astro:assets <Picture> can't do on its own.
import { artDirectedSources } from "../lib/images";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src"> {
  mobile: ImageMetadata;
  desktop: ImageMetadata;
  sizes: string;
  alt: string;
}

const { mobile, desktop, sizes, ...imgAttrs } = Astro.props;
const sources = await artDirectedSources(mobile, desktop);
---

<picture>
  <source
    srcset={sources.mobile.srcSet.attribute}
    sizes={sizes}
    media="(max-width:639px)"
    width={mobile.width}
    height={mobile.height}
  />
  <source
    srcset={sources.desktop.srcSet.attribute}
    sizes={sizes}
    media="(min-width:640px)"
    width={desktop.width}
    height={desktop.height}
  />
  <img src={sources.desktop.src} width={desktop.width} height={desktop.height} {...imgAttrs} />
</picture>
