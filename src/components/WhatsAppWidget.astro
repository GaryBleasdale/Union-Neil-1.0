---
// Floating shortcut that opens the contact dialog (Contact.astro), which
// routes visitors to the right WhatsApp number. Without JavaScript it falls
// back to the "Vamos conversar" section.
import Img from "./Img.astro";
import whatsappIcon from "../assets/whatsapp-icon.png";
---

<!-- Starts hidden; the script below reveals it once the visitor is past the hero.
     --cookie-banner-h (set by CookieBanner.astro) keeps it above the cookie banner. -->
<a href="#contato" id="whatsapp-widget" aria-label="Falar com a Union" aria-haspopup="dialog" data-hidden inert
  class="fixed right-3 bottom-[calc(--spacing(3)+var(--cookie-banner-h,0px))] z-10 rounded-full drop-shadow-lg transition duration-200 hover:scale-105 data-hidden:pointer-events-none data-hidden:translate-y-2 data-hidden:opacity-0 md:right-4 md:bottom-[calc(--spacing(4)+var(--cookie-banner-h,0px))]">
  <Img src={whatsappIcon} width={65} densities={[1, 2, 3]} class="w-15 md:w-16.25" alt="" loading="eager" />
</a>

<script>
  // Show the widget only once the second paragraph of the section after the
  // hero comes into view, and hide it again while the section's own "Quero
  // falar com a Union" button is on screen, so the two don't compete.
  const widget = document.getElementById("whatsapp-widget")!;
  const dialog = document.getElementById("contact-dialog") as HTMLDialogElement | null;

  if (dialog) {
    widget.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
    });
  }
  const start = document.getElementById("whatsapp-widget-start");
  const cta = document.getElementById("contact-cta");

  let pastStart = false;
  let ctaVisible = false;

  function update() {
    const hidden = !pastStart || ctaVisible;
    widget.toggleAttribute("data-hidden", hidden);
    widget.inert = hidden;
  }

  if (start) {
    // A position check rather than an IntersectionObserver: jumping straight
    // from below the marker to above it (e.g. back to the top) never crosses
    // an observer's threshold, so the widget would stay visible over the hero.
    const checkStart = () => {
      pastStart = start.getBoundingClientRect().top < innerHeight;
      update();
    };
    addEventListener("scroll", checkStart, { passive: true });
    addEventListener("resize", checkStart);
    checkStart();
  } else {
    pastStart = true;
    update();
  }

  if (cta) {
    new IntersectionObserver(([entry]) => {
      ctaVisible = entry.isIntersecting;
      update();
    }).observe(cta);
  }
</script>
