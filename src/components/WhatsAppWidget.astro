---
// Floating shortcut to the "Vamos conversar" section, where the contact
// dialog routes visitors to the right WhatsApp number.
import Img from "./Img.astro";
import whatsappIcon from "../assets/whatsapp-icon.avif";
---

<a href="#contato" id="whatsapp-widget" aria-label="Falar com a Union"
  class="fixed right-3 bottom-3 z-10 rounded-full drop-shadow-lg transition duration-200 hover:scale-105 data-hidden:pointer-events-none data-hidden:translate-y-2 data-hidden:opacity-0 md:right-4 md:bottom-4">
  <Img src={whatsappIcon} class="w-15 md:w-16.25" alt="" loading="eager" />
</a>

<script>
  // Hide the widget while the section's own "Quero falar com a Union" button
  // is on screen, so the two don't compete.
  const widget = document.getElementById("whatsapp-widget")!;
  const cta = document.getElementById("contact-cta");

  if (cta) {
    new IntersectionObserver(([entry]) => {
      widget.toggleAttribute("data-hidden", entry.isIntersecting);
      widget.inert = entry.isIntersecting;
    }).observe(cta);
  }
</script>
