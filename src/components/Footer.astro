---
import Img from "./Img.astro";
import icon from "../assets/union_neil_icon.png";
---

<footer class="h-max w-full p-7.5 bg-[lightyellow]">
  <div class="flex flex-col items-center justify-center gap-7">
    <Img src={icon} class="w-37.5" alt="Union Neil Icon" />
    <p class="text-center">
      Union Neil Ltda. é uma empresa registrada no Brasil sob o
      <strong>CNPJ 48.768.101/0001-33</strong>
    </p>
    <p class="text-center">
      🏢 Av. Washington Luiz 310, Torre White, sala 116 - Jardim Emilia,
      Sorocaba - SP, 18031-000
    </p>
    <p class="text-center">✉️ atendimento@unionneil.com.br</p>
    <p class="text-center" x-data>
      © <span x-text="new Date().getFullYear(); "></span> Union Neil Ltda. Todos os direitos reservados
    </p>
    <p class="text-center">
      <a href="/privacidade" style="font-size: 18px"><strong>POLÍTICA DE
          PRIVACIDADE DE DADOS</strong></a>
    </p>
  </div>
</footer>
