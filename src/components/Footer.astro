---
import Img from "./Img.astro";
import icon from "../assets/union_neil_icon.png";
---

<!-- Extra bottom padding keeps the floating cookie and WhatsApp buttons
     (bottom corners, ~60px tall) off the last line of the footer. -->
<footer class="h-max w-full p-7.5 pb-24 bg-[lightyellow]">
  <div class="flex flex-col items-center justify-center gap-7">
    <Img src={icon} class="w-37.5" alt="Union Neil Icon" />
    <p class="text-center">
      Union Neil Ltda. é uma empresa registrada no Brasil sob o <strong>CNPJ 48.768.101/0001-33</strong>
    </p>
    <p class="text-center">
      🏢 <a href="https://maps.google.com/?cid=2645807140813797670" target="_blank" rel="noopener"
        class="underline underline-offset-2 hover:no-underline">Av. Washington Luiz 310, Torre White, sala 116 - Jardim Emilia,
        Sorocaba - SP, 18031-000</a>
    </p>
    <p class="text-center">
      ✉️ <a href="mailto:atendimento@unionneil.com.br" class="underline underline-offset-2 hover:no-underline">atendimento@unionneil.com.br</a>
    </p>
    <p class="text-center" x-data>
      © <span x-text="new Date().getFullYear(); "></span> Union Neil Ltda. Todos os direitos reservados
    </p>
    <p class="text-center">
      <a href="/privacidade" style="font-size: 18px"><strong>POLÍTICA DE
          PRIVACIDADE DE DADOS</strong></a>
    </p>
  </div>
</footer>
