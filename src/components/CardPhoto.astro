---
// A service card's photo, cut at build time to the shape the card shows it
// in: 16:9 on phones, 4:3 from md (768px). Serving the image already cropped
// (rather than a 4:3 file cropped by object-fit) means phones don't download
// the quarter of each photo they never see. `sizes` follows the card's real
// width: the container's 30px side padding, the grid gaps (30px) and the 2px
// border on each side.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;

// AVIF variants of `src` cut to width:height, at the given widths (never
// wider than the original, which would only upscale it).
const crop = (width: number, height: number, widths: number[]) => {
  const fit = widths.filter((w) => w <= src.width);
  return getImage({
    src,
    format: "avif",
    width,
    height,
    fit: "cover",
    widths: fit.length ? fit : [src.width],
  });
};

const [wide, classic] = await Promise.all([
  crop(1280, 720, [320, 480, 640, 800, 960, 1280]),
  crop(800, 600, [320, 400, 480, 640, 800]),
]);
---

<picture>
  <source
    media="(min-width: 768px)"
    srcset={classic.srcSet.attribute}
    sizes="(min-width: 1300px) 389px, (min-width: 1024px) calc((100vw - 120px) / 3 - 4px), calc((100vw - 90px) / 2 - 4px)"
    width={classic.attributes.width}
    height={classic.attributes.height}
  />
  <img
    src={wide.src}
    srcset={wide.srcSet.attribute}
    sizes="calc(100vw - 64px)"
    width={wide.attributes.width}
    height={wide.attributes.height}
    alt={alt}
    loading="lazy"
    decoding="async"
    class:list={["block w-full object-cover", className]}
  />
</picture>
