---
import Anchor from "./Anchor.astro";
import SectionTitle from "./SectionTitle.astro";
import Img from "./Img.astro";
import whatsappIcon from "../assets/whatsapp-icon.png";

// Each option goes straight to WhatsApp. Only "family" counts as a Google
// Ads conversion (see the script below).
const options = [
    {
        id: "family",
        label: "Preciso de cuidados para uma pessoa amada",
        // Same number as the old https://wa.link/rtvc0v, without its emojis
        // (they showed as "?" for some visitors).
        href: "https://wa.me/5515981012944?text=Ol%C3%A1%20Union%20Neil!%20Estou%20precisando%20de%20cuidados%20domiciliares.%20Podem%20me%20ajudar%3F",
    },
    {
        id: "work",
        label: "Sou cuidador(a) e quero trabalhar com a Union",
        href: "https://wa.me/5515981113016?text=Ol%C3%A1%20Union%2C%20estou%20interessado%20em%20deixar%20meu%20curr%C3%ADculo%20com%20voc%C3%AAs.",
    },
];
---

<Anchor id="contato" />
<div class="container">
    <SectionTitle>Vamos conversar</SectionTitle>
    <div class="text-lg mb-5 lg:my-10 lg:text-xl">
        <p class="mb-3">
            Adoramos ouvir sua história e estamos prontos para dialogar, seja
            por uma chamada rápida ou uma conversa no WhatsApp.
        </p>
        <p>
            Vamos conhecer sua situação detalhadamente e orientá-lo sobre os
            próximos passos com todo o respeito e atenção que você merece.
        </p>
        <div class="flex items-center justify-center flex-col" x-data>
            <button
                type="button"
                id="contact-cta"
                @click="$refs.contactDialog.showModal()"
                class="mt-12 p-3 rounded-[40px] border-2 text-lg text-[#242424] flex flex-row items-center py-3 px-6 shadow-md hover:shadow-lg transition-all duration-300 border-[darkgoldenrod] bg-[rgb(184,134,11,0.15)]"
            >
                <Img
                    src={whatsappIcon}
                    width={50}
                    densities={[1, 2, 3]}
                    class="w-12.5 mr-3"
                    alt=""
                />
                <strong class="text-center">Quero falar com a Union</strong>
            </button>

            <dialog
                x-ref="contactDialog"
                id="contact-dialog"
                closedby="any"
                aria-labelledby="contact-dialog-title"
                class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg bg-white p-6 text-[#242424] shadow-lg backdrop:bg-black/50"
            >
                <div class="flex items-start justify-between gap-4 mb-5">
                    <h3 id="contact-dialog-title" class="text-xl font-bold">
                        Como podemos ajudar?
                    </h3>
                    <button
                        type="button"
                        aria-label="Fechar"
                        @click="$refs.contactDialog.close()"
                        class="-mt-1 -mr-2 flex size-9 shrink-0 items-center justify-center rounded-full text-2xl leading-none hover:bg-black/5"
                    >
                        ×
                    </button>
                </div>

                <p class="mb-4 flex items-center gap-2.5 text-base text-[#4a4a4a]">
                    <Img
                        src={whatsappIcon}
                        width={28}
                        densities={[1, 2, 3]}
                        class="w-7 shrink-0"
                        alt=""
                        loading="eager"
                    />
                    Clique na opção certa para iniciar seu atendimento no WhatsApp.
                </p>
                <!-- Rows in the old dropdown's style, each opening WhatsApp
                     directly. The chevron shows they're tappable; the family
                     row (the main option) gets a faint gold tint. -->
                <div class="flex flex-col gap-3">
                    {options.map((option) => (
                        <a
                            href={option.href}
                            target="_blank"
                            rel="noopener"
                            data-contact-option={option.id}
                            class:list={[
                                "flex items-center gap-2.5 rounded-xl border-2 px-4 py-3 text-base leading-[1.4] text-[#242424] transition-colors hover:border-[#daa520aa] hover:bg-[rgb(184,134,11,0.1)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[darkgoldenrod]",
                                option.id === "family"
                                    ? "border-[#daa52099] bg-[rgb(184,134,11,0.06)]"
                                    : "border-[#daa52066] bg-white",
                            ]}
                        >
                            <!-- Same gold diamond as the mobile navbar links. -->
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="#CFB52C"
                                aria-hidden="true"
                                class="size-3.75 shrink-0"
                            >
                                <path d="M12 23a1 1 0 0 1-.78-.38l-8-10c-.29-.37-.29-.88 0-1.25l8-9.99c.38-.47 1.18-.47 1.56 0l8 10c.29.37.29.88 0 1.25l-8 10a1 1 0 0 1-.78.38ZM5.28 12 12 20.4l6.72-8.4L12 3.6 5.28 12Z" />
                            </svg>
                            <span class="grow">{option.label}</span>
                            <!-- "chevron-right" icon from Lucide (ISC licence) -->
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="#b8860b"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                class="size-5 shrink-0"
                            >
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    ))}
                </div>
            </dialog>
        </div>
    </div>
</div>

<script>
    // Safari doesn't support closedby="any" yet: close on backdrop clicks manually.
    const dialog = document.getElementById(
        "contact-dialog",
    ) as HTMLDialogElement;
    if (!("closedBy" in HTMLDialogElement.prototype)) {
        dialog.addEventListener("click", (event) => {
            if (event.target !== dialog) return;
            const rect = dialog.getBoundingClientRect();
            const inside =
                rect.top <= event.clientY &&
                event.clientY <= rect.bottom &&
                rect.left <= event.clientX &&
                event.clientX <= rect.right;
            if (!inside) dialog.close();
        });
    }

    // Google tag events (gtag is defined in Layout.astro when analytics is on).
    // Only the family option is an Ads conversion, so the campaign isn't
    // credited for job applicants; both buttons are GA4 events, to see which
    // channels (ads, organic, social...) the clicks come from.
    declare const gtag: ((...args: unknown[]) => void) | undefined;

    // Click log: each family click sends the visitor's Google Ads click IDs
    // to a Google Sheet (Apps Script in scripts/lead-log.gs), with the click
    // time. When a chat arrives, its time finds the row, and the gclid is
    // uploaded as an offline conversion. The ref is only the row's ID (the
    // Sheet script requires one). Skipped if the visitor refused cookies.
    // Apps Script web app URL (scripts/lead-log.gs)
    const LEAD_LOG_URL =
        "https://script.google.com/macros/s/AKfycbxf2YupSV69ruj_mogt6Qptdv0nwU1Lsw5tlqDs6_DXHErOAa-HIgbpvQRBkV6pSeM-qw/exec";

    function newRef() {
        const chars = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"; // no 0/O, 1/I/L
        const bytes = crypto.getRandomValues(new Uint8Array(5));
        return Array.from(bytes, (b) => chars[b % chars.length]).join("");
    }

    function readCookie(name: string) {
        const m = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
        return m ? decodeURIComponent(m[1]) : "";
    }

    // IDs saved on landing (Layout.astro); gtag's own _gcl_aw cookie
    // ("GCL.<time>.<gclid>") is the fallback for the gclid.
    function clickIds() {
        let ids: Record<string, string> = {};
        try {
            ids = JSON.parse(readCookie("union_click") || "{}");
        } catch {}
        if (!ids.gclid) {
            const aw = readCookie("_gcl_aw").split(".");
            if (aw.length >= 3) ids.gclid = aw.slice(2).join(".");
        }
        return ids;
    }

    function logClick(link: HTMLAnchorElement) {
        const consent = (window as any).unionConsent?.get?.();
        if (consent === "denied") return;
        const ids = clickIds();
        navigator.sendBeacon(
            LEAD_LOG_URL,
            JSON.stringify({
                ref: newRef(),
                option: link.dataset.contactOption,
                gclid: ids.gclid || "",
                gbraid: ids.gbraid || "",
                wbraid: ids.wbraid || "",
                landed_at: ids.at || "",
                clicked_at: new Date().toISOString(),
                page: location.pathname,
            }),
        );
    }

    for (const link of dialog.querySelectorAll<HTMLAnchorElement>(
        "[data-contact-option]",
    )) {
        link.addEventListener("click", () => {
            if (link.dataset.contactOption === "family") logClick(link);
            if (typeof gtag !== "function") return;
            if (link.dataset.contactOption === "family") {
                gtag("event", "conversion", {
                    send_to: "AW-11343656312/2TwlCInQgqkdEPjqiaEq",
                });
                gtag("event", "generate_lead", {
                    send_to: "G-T55SWE3RWZ",
                    method: "whatsapp",
                });
            } else {
                gtag("event", "cv_submit", {
                    send_to: "G-T55SWE3RWZ",
                    method: "whatsapp",
                });
            }
        });
    }
</script>
