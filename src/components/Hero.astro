---
import ArtDirectedPicture from "./ArtDirectedPicture.astro";
import heroMobile from "../assets/mobile_hero_placeholder-min.avif";
import heroDesktop from "../assets/hero_desktop_placeholder-min.avif";
---

<div class="relative aspect-259/464 sm:aspect-927/520 pt-26.5 sm:pt-32.5">
  <div class="absolute bg-[linear-gradient(to_bottom,#e3cd94ba_0%,rgba(0,0,0,0)_33%)] h-full w-full">
    <h1
      class="font-bold text-center  text-[2.5rem]  md:text-5xl xl:text-7xl px-2 py-8 text-[#393939] tracking-[-2px] leading-9.75 md:leading-none">
      Cuidados domiciliares para pessoas <strong class="text-[#151515]">exigentes</strong>
    </h1>
  </div>
  <ArtDirectedPicture
    mobile={heroMobile}
    desktop={heroDesktop}
    sizes="100vw"
    alt="imagem de cabeçeira"
    fetchpriority="high"
  />
  <div
    class="flex flex-col items-center justify-between gap-7 pt-16 bg-[linear-gradient(to_top,rgba(0,0,0,0.25)_67%,rgba(0,0,0,0)_100%)] absolute w-full bottom-0">
    <div>
      <a href="#intro"
        class="mt-7 p-3 rounded-[40px] border text-lg text-[#242424] bg-[rgb(218,165,32,0.8)]"><strong>QUERO SABER
          MAIS</strong></a>
    </div>

    <a href="#contato"
      class="p-3 text-[#242424] rounded-[40px] text-base bg-[rgb(218,165,32,0.8)] mb-7"><strong>QUERO FALAR COM A
        UNION</strong></a>
  </div>
</div>
